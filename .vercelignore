# Not part of the site: keep these out of every Vercel deployment so they are
# not publicly served or crawled. They stay in the repo.

# Development leftovers
archive/
scratch/

# Generators and the pre-deploy check. They run locally (npm run build:pages,
# build:sitemap, check:site); their output is committed. Nothing at runtime
# imports them.
scripts/

# Tailwind build-time inputs. The compiled output (tailwind-main.css,
# tailwind-pdf.css) IS committed and served; these are only needed to rebuild
# it locally via npm run build:css.
src/
tailwind.config.main.cjs
tailwind.config.pdf.cjs

# Internal notes
GUIDE.md
FIX_INSTRUCTIONS_EraserPro.md
SEO_and_Blogging_Guide.pdf

# Netlify config; Vercel reads vercel.json instead
_headers
