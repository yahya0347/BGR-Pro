  font-weight: 700;
}

.quick-size-btn span:last-child {
  font-size: 0.65rem;
  color: var(--text-muted);
}

.quick-size-btn:hover {
  border-color: var(--primary);
  background-color: rgba(124, 58, 237, 0.05);
}

/* Divider */
.sidebar-divider {
