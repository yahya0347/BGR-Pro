  font-weight: 800;
  font-size: 0.7rem;
  padding: 2px 8px;
  border-radius: var(--border-radius-full);
  display: inline-block;
  margin-bottom: 8px;
  letter-spacing: 0.05em;
}

.pro-ad-banner p {
  font-size: 0.75rem;
  color: var(--text-secondary);
  line-height: 1.4;
}

.pro-ad-banner p strong {
  color: white;
