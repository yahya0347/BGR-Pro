}

.res-num-input {
  width: 100%;
  background: transparent;
  border: none;
  color: var(--text-primary);
  font-family: var(--font-family-sans);
  font-size: 0.95rem;
  font-weight: 700;
  outline: none;
}

/* Pro Banner Ad */
.pro-ad-banner {
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.08) 0%, rgba(124, 58, 237, 0.08) 100%);
  border: 1px dashed var(--border-gold);
