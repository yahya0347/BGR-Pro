}

.config-instructions {
  font-size: 0.85rem;
  color: var(--text-secondary);
  line-height: 1.5;
  background-color: rgba(30, 41, 59, 0.4);
  border: 1px solid var(--border-light);
  padding: 12px;
  border-radius: var(--border-radius-md);
}

