  background: var(--border-light);
  margin: 24px 0;
}

/* Resolution custom row */
.custom-res-row {
  display: flex;
  align-items: center;
  gap: 10px;
  background-color: var(--bg-darkest);
  border: 1px solid var(--border-light);
  padding: 6px 12px;
  border-radius: var(--border-radius-md);
}

.input-unit {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.input-unit span {
